      "assets/audio/delivery-10.mp3",
      "assets/audio/delivery-10-slow.mp3"
    ]
  },
  {
    "id": "neighbours-01",
    "text": "ನಮಸ್ಕಾರ, ಹೇಗಿದ್ದೀರಾ?",
